# Native Linux build of OpenShop for fast UI iteration (mouse = Wii Remote pointer).
# Requires: libsdl2-dev libsdl2-ttf-dev libsdl2-mixer-dev libjansson-dev libsdl2-image-dev
CXX      ?= g++
BUILD    := build-pc
TARGET   := $(BUILD)/openshop
PKGS     := sdl2 SDL2_ttf SDL2_mixer SDL2_image jansson

# WERROR=1 turns any warning into an error (the zero-warning rule).
# SAN=1 builds the app and the tests with AddressSanitizer + UBSan into build-pc-san/, so
# sanitizer and normal objects never mix. Example: make -f Makefile.pc SAN=1 test
WARN     := -Wall -Wextra
ifeq ($(WERROR),1)
WARN     += -Werror
endif
SANFLAGS :=
ifeq ($(SAN),1)
BUILD    := build-pc-san
TARGET   := $(BUILD)/openshop
SANFLAGS := -fsanitize=address,undefined -fno-omit-frame-pointer -fno-sanitize-recover=undefined -fno-var-tracking-assignments
endif

DEFS     :=
ifeq ($(DEBUGTOOLS),1)
DEFS     += -DOPENSHOP_DEBUGTOOLS
BUILD    := $(BUILD)-debug
TARGET   := $(BUILD)/openshop
endif

CXXFLAGS := -std=gnu++20 -g -O1 $(WARN) $(SANFLAGS) $(DEFS) -Isrc -MMD -MP $(shell pkg-config --cflags $(PKGS))
ASFLAGS  := -Wa,-I.
LDLIBS   := $(shell pkg-config --libs $(PKGS)) -lz -lm

# The flags this build dir was made with (same idea as build/.flags in Makefile). Rewritten only when they change, so
# WERROR=1 on a built tree recompiles, and a plain build afterwards recompiles again.
STAMP := $(BUILD)/.flags
.PHONY: FORCE
.DEFAULT_GOAL := $(TARGET)
# Under `make -n` a FORCE'd stamp would be assumed rewritten and make every object look out of date, so a dry run only
# checks that the stamp exists (the flag comparison is for real builds).
ifneq ($(findstring n,$(firstword -$(MAKEFLAGS))),)
STAMPDEP :=
else
STAMPDEP := FORCE
endif
$(STAMP): $(STAMPDEP)
	@mkdir -p $(BUILD)
	@printf '%s\n' '$(CXXFLAGS)' | cmp -s - $@ || printf '%s\n' '$(CXXFLAGS)' > $@

SRCS := $(shell find src -name '*.cpp')
OBJS := $(SRCS:%.cpp=$(BUILD)/%.o) $(BUILD)/src/assets.o

$(TARGET): $(OBJS)
	$(CXX) $(SANFLAGS) -o $@ $^ $(LDLIBS)

$(BUILD)/%.o: %.cpp $(STAMP)
	@mkdir -p $(dir $@)
	$(CXX) $(CXXFLAGS) -c $< -o $@

$(BUILD)/src/assets.o: src/assets.S $(wildcard assets/fonts/*.ttf)
	@mkdir -p $(dir $@)
	$(CXX) $(ASFLAGS) -c $< -o $@

# Host-side tests (no app, mostly no SDL window). Not part of the app or the Wii build.
# Every test is linked from per-file objects in $(BUILD)/tobj/ compiled with -MMD -MP, so editing any header or source
# rebuilds exactly the tests that include it (no hand-listed header dependencies to go stale). Test objects are kept
# apart from the app's: they are built without DEFS, so a DEBUGTOOLS build dir never gets the debug log hooks in tests.
# Fixtures under tests/fixtures/ are read at run time, so they are not build dependencies.
TESTCXX := -std=gnu++20 -g -O1 $(WARN) $(SANFLAGS) -Isrc -Itests -pthread -MMD -MP $(shell pkg-config --cflags sdl2 SDL2_image jansson)
SDLLIBS := $(shell pkg-config --libs sdl2)
JANSSONLIBS := $(shell pkg-config --libs jansson)

tobj = $(patsubst %.cpp,$(BUILD)/tobj/%.o,$(1))

$(BUILD)/tobj/%.o: %.cpp $(STAMP)
	@mkdir -p $(dir $@)
	$(CXX) $(TESTCXX) -c $< -o $@

NETSRCS := src/net/HttpTransfer.cpp src/net/HttpPosix.cpp src/net/HttpParse.cpp src/net/Sinks.cpp src/core/FileUtil.cpp
ICONSRCS := src/gfx/IconCache.cpp src/gfx/IconPng.cpp src/gfx/IconStore.cpp src/catalog/Catalog.cpp src/net/Worker.cpp $(NETSRCS)
LOADERSRCS := src/catalog/NetLoader.cpp src/catalog/CatalogLoader.cpp src/catalog/MockLoader.cpp src/catalog/MockCatalog.cpp src/core/DevOptions.cpp src/catalog/OscApi.cpp src/catalog/CatalogCache.cpp src/catalog/Catalog.cpp src/net/Worker.cpp $(NETSRCS)

# name -> sources (tests/<name>.cpp is added automatically) and extra link libraries.
TESTS := catalog_test core_test topbar_test layout_test http_parse_test http_transfer_test http_posix_test worker_test \
         nettest_script_test oscapi_test netloader_test cache_test wrap_test httpget gfx_test icon_test
SRCS_catalog_test        := src/catalog/Catalog.cpp src/catalog/MockCatalog.cpp
SRCS_core_test           := src/core/DevOptions.cpp
SRCS_topbar_test         :=
SRCS_layout_test         :=
SRCS_http_parse_test     := src/net/HttpParse.cpp src/net/Sinks.cpp src/core/FileUtil.cpp
SRCS_http_transfer_test  := src/net/HttpTransfer.cpp src/net/HttpParse.cpp src/net/Sinks.cpp src/core/FileUtil.cpp
SRCS_http_posix_test     := $(NETSRCS)
# The worker uses SDL threads and mutexes (no SDL_Init), so it links SDL.
SRCS_worker_test         := src/net/Worker.cpp $(NETSRCS)
LIBS_worker_test         := $(SDLLIBS)
# NetSelfTest.cpp references the worker, so those sources are linked too.
SRCS_nettest_script_test := src/net/NetSelfTest.cpp src/net/Worker.cpp $(NETSRCS)
LIBS_nettest_script_test := $(SDLLIBS)
SRCS_oscapi_test         := src/catalog/OscApi.cpp src/catalog/Catalog.cpp
LIBS_oscapi_test         := $(JANSSONLIBS)
SRCS_netloader_test      := $(LOADERSRCS)
LIBS_netloader_test      := $(SDLLIBS) $(JANSSONLIBS)
SRCS_cache_test          := src/catalog/CatalogCache.cpp src/core/FileUtil.cpp src/catalog/OscApi.cpp src/catalog/Catalog.cpp
LIBS_cache_test          := $(JANSSONLIBS)
SRCS_wrap_test           :=
# Dev tool, built by `make test` but not run (it needs a URL). See the header comment in the file.
SRCS_httpget             := src/net/Worker.cpp $(NETSRCS)
LIBS_httpget             := $(SDLLIBS)
# The one test that draws: the button helpers into a software renderer (no window, no display).
SRCS_gfx_test            := src/gfx/Gfx.cpp
LIBS_gfx_test            := $(SDLLIBS) -lm
# Real icons: PNG validation, the SD icon store, the IconCache against a real worker and a loopback server.
SRCS_icon_test           := $(ICONSRCS)
LIBS_icon_test           := $(SDLLIBS) $(shell pkg-config --libs SDL2_image) -lz

define TESTRULE
$$(BUILD)/tests/$(1): $$(call tobj,tests/$(1).cpp $$(SRCS_$(1)))
	@mkdir -p $$(dir $$@)
	$$(CXX) $$(SANFLAGS) -pthread -o $$@ $$^ $$(LIBS_$(1))
endef
$(foreach t,$(TESTS),$(eval $(call TESTRULE,$(t))))

TESTBINS := $(addprefix $(BUILD)/tests/,$(TESTS))
# httpget is built but not run (it needs a URL).
RUNTESTS := $(filter-out $(BUILD)/tests/httpget,$(TESTBINS))
TESTOBJS := $(sort $(foreach t,$(TESTS),$(call tobj,tests/$(t).cpp $(SRCS_$(t)))))

test: $(TESTBINS)
	@set -e; for t in $(RUNTESTS); do echo "== $$t"; $$t; done

clean:
	rm -rf $(BUILD)

-include $(OBJS:.o=.d) $(TESTOBJS:.o=.d)
.PHONY: clean test
