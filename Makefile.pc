# Native Linux build of OpenShop for fast UI iteration (mouse = Wii Remote pointer).
# Requires: libsdl2-dev libsdl2-ttf-dev libsdl2-mixer-dev libjansson-dev libsdl2-image-dev
CXX      ?= g++
BUILD    := build-pc
TARGET   := $(BUILD)/openshop
PKGS     := sdl2 SDL2_ttf SDL2_mixer SDL2_image jansson

# WERROR=1 turns any warning into an error (the zero-warning rule).
# SAN=1 builds the app and the tests with AddressSanitizer + UBSan into build-pc-san/, so
# sanitizer and normal objects never mix. Example: make -f Makefile.pc SAN=1 test
WARN     := -Wall -Wextra
ifeq ($(WERROR),1)
WARN     += -Werror
endif
SANFLAGS :=
ifeq ($(SAN),1)
BUILD    := build-pc-san
TARGET   := $(BUILD)/openshop
SANFLAGS := -fsanitize=address,undefined -fno-omit-frame-pointer -fno-sanitize-recover=undefined -fno-var-tracking-assignments
endif

DEFS     :=
ifeq ($(DEBUGTOOLS),1)
DEFS     += -DOPENSHOP_DEBUGTOOLS
BUILD    := $(BUILD)-debug
TARGET   := $(BUILD)/openshop
endif

CXXFLAGS := -std=gnu++20 -g -O1 $(WARN) $(SANFLAGS) $(DEFS) -Isrc -MMD -MP $(shell pkg-config --cflags $(PKGS))
ASFLAGS  := -Wa,-I.
LDLIBS   := $(shell pkg-config --libs $(PKGS)) -lm

SRCS := $(shell find src -name '*.cpp')
OBJS := $(SRCS:%.cpp=$(BUILD)/%.o) $(BUILD)/src/assets.o

$(TARGET): $(OBJS)
	$(CXX) $(SANFLAGS) -o $@ $^ $(LDLIBS)

$(BUILD)/%.o: %.cpp
	@mkdir -p $(dir $@)
	$(CXX) $(CXXFLAGS) -c $< -o $@

$(BUILD)/src/assets.o: src/assets.S $(wildcard assets/fonts/*.ttf)
	@mkdir -p $(dir $@)
	$(CXX) $(ASFLAGS) -c $< -o $@

# Host-side tests for pure logic (no SDL). Not part of the app or the Wii build.
TESTBIN := $(BUILD)/tests/catalog_test
TESTCXX := -std=gnu++20 -g -O1 $(WARN) $(SANFLAGS) -Isrc

$(TESTBIN): tests/catalog_test.cpp src/catalog/Catalog.cpp src/catalog/MockCatalog.cpp src/catalog/Catalog.h
	@mkdir -p $(dir $@)
	$(CXX) $(TESTCXX) -o $@ tests/catalog_test.cpp src/catalog/Catalog.cpp src/catalog/MockCatalog.cpp

CORETEST := $(BUILD)/tests/core_test

$(CORETEST): tests/core_test.cpp src/core/DevOptions.cpp src/core/DevOptions.h src/catalog/InstallGuard.h src/catalog/RefreshPolicy.h src/catalog/LoadTracker.h
	@mkdir -p $(dir $@)
	$(CXX) $(TESTCXX) -o $@ tests/core_test.cpp src/core/DevOptions.cpp

TOPBARTEST := $(BUILD)/tests/topbar_test

$(TOPBARTEST): tests/topbar_test.cpp src/ui/TopBarLayout.h
	@mkdir -p $(dir $@)
	$(CXX) $(TESTCXX) -o $@ tests/topbar_test.cpp

LAYOUTTEST := $(BUILD)/tests/layout_test

$(LAYOUTTEST): tests/layout_test.cpp src/ui/HomeLayout.h
	@mkdir -p $(dir $@)
	$(CXX) $(TESTCXX) -o $@ tests/layout_test.cpp

HTTPPARSETEST := $(BUILD)/tests/http_parse_test

$(HTTPPARSETEST): tests/http_parse_test.cpp src/net/HttpParse.cpp src/net/HttpParse.h src/net/Http.h src/net/Sinks.cpp src/core/Version.h
	@mkdir -p $(dir $@)
	$(CXX) $(TESTCXX) -o $@ tests/http_parse_test.cpp src/net/HttpParse.cpp src/net/Sinks.cpp

HTTPTRANSFERTEST := $(BUILD)/tests/http_transfer_test

$(HTTPTRANSFERTEST): tests/http_transfer_test.cpp tests/FakeTransport.h src/net/HttpTransfer.cpp src/net/HttpTransfer.h src/net/Transport.h src/net/HttpParse.cpp src/net/HttpParse.h src/net/Http.h src/net/Sinks.cpp src/core/Log.h src/core/Version.h
	@mkdir -p $(dir $@)
	$(CXX) $(TESTCXX) -Itests -o $@ tests/http_transfer_test.cpp src/net/HttpTransfer.cpp src/net/HttpParse.cpp src/net/Sinks.cpp

# Real sockets over loopback (a server thread inside the test), so -pthread. No SDL.
HTTPPOSIXTEST := $(BUILD)/tests/http_posix_test
NETSRCS := src/net/HttpTransfer.cpp src/net/HttpPosix.cpp src/net/HttpParse.cpp src/net/Sinks.cpp
NETDEPS := $(NETSRCS) src/net/HttpTransfer.h src/net/HttpPosix.h src/net/Transport.h src/net/HttpParse.h src/net/Http.h src/core/Log.h src/core/Version.h tests/LoopbackServer.h

$(HTTPPOSIXTEST): tests/http_posix_test.cpp $(NETDEPS)
	@mkdir -p $(dir $@)
	$(CXX) $(TESTCXX) -Itests -pthread -o $@ tests/http_posix_test.cpp $(NETSRCS)

# The worker uses SDL threads and mutexes (no SDL_Init), so this one links SDL like gfx_test.
WORKERTEST := $(BUILD)/tests/worker_test

$(WORKERTEST): tests/worker_test.cpp src/net/Worker.cpp src/net/Worker.h $(NETDEPS)
	@mkdir -p $(dir $@)
	$(CXX) $(TESTCXX) -Itests -pthread $(shell pkg-config --cflags sdl2) -o $@ tests/worker_test.cpp src/net/Worker.cpp $(NETSRCS) $(shell pkg-config --libs sdl2)

# The self-test's script parser. NetSelfTest.cpp references the worker, so those sources are linked too.
NETTESTTEST := $(BUILD)/tests/nettest_script_test

$(NETTESTTEST): tests/nettest_script_test.cpp src/net/NetSelfTest.cpp src/net/NetSelfTest.h src/net/Worker.cpp src/net/Worker.h $(NETDEPS)
	@mkdir -p $(dir $@)
	$(CXX) $(TESTCXX) -pthread $(shell pkg-config --cflags sdl2) -o $@ tests/nettest_script_test.cpp src/net/NetSelfTest.cpp src/net/Worker.cpp $(NETSRCS) $(shell pkg-config --libs sdl2)

# Dev tool, built by `make test` but not run (it needs a URL). See the header comment in the file.
HTTPGET := $(BUILD)/tests/httpget

$(HTTPGET): tests/httpget.cpp src/net/Worker.cpp src/net/Worker.h $(NETDEPS)
	@mkdir -p $(dir $@)
	$(CXX) $(TESTCXX) -pthread $(shell pkg-config --cflags sdl2) -o $@ tests/httpget.cpp src/net/Worker.cpp $(NETSRCS) $(shell pkg-config --libs sdl2)

# The one test that needs SDL: draws the button helpers into a software renderer (no window, no display).
GFXTEST := $(BUILD)/tests/gfx_test

$(GFXTEST): tests/gfx_test.cpp src/gfx/Gfx.cpp src/gfx/Gfx.h src/gfx/Theme.h src/core/Types.h
	@mkdir -p $(dir $@)
	$(CXX) $(TESTCXX) $(shell pkg-config --cflags sdl2) -o $@ tests/gfx_test.cpp src/gfx/Gfx.cpp $(shell pkg-config --libs sdl2) -lm

test: $(TESTBIN) $(CORETEST) $(TOPBARTEST) $(LAYOUTTEST) $(HTTPPARSETEST) $(HTTPTRANSFERTEST) $(HTTPPOSIXTEST) $(WORKERTEST) $(NETTESTTEST) $(HTTPGET) $(GFXTEST)
	$(TESTBIN)
	$(CORETEST)
	$(TOPBARTEST)
	$(LAYOUTTEST)
	$(HTTPPARSETEST)
	$(HTTPTRANSFERTEST)
	$(HTTPPOSIXTEST)
	$(WORKERTEST)
	$(NETTESTTEST)
	$(GFXTEST)

clean:
	rm -rf $(BUILD)

-include $(OBJS:.o=.d)
.PHONY: clean test
