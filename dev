#!/usr/bin/env bash
# OpenShop dev workflow: build with devkitPPC, test in Dolphin.
#
#   ./dev build [make args]   build OpenShop.elf / OpenShop.dol
#   ./dev run                 build, then (re)launch in Dolphin with logs in this terminal
#   ./dev watch               rebuild + relaunch Dolphin whenever source changes
#   ./dev pc                  build + run the native Linux version (fast UI iteration)
#   ./dev watch-pc            rebuild + relaunch the Linux version on changes
#   ./dev clean               remove build output
#
#   run / watch / pc / watch-pc accept dev options, in any order, before any other arguments:
#     --screen <home|search|list|detail|dialog>   start directly on that screen
#     --mock                                      use the compiled-in mock catalog
#     --offline                                   use the cache only, no network
#     --refresh                                   ignore the cache TTL
#     --fail[=startup|refresh|both|none]          make the first startup load fail (error screen; Retry works) and/or
#                                                 every Refresh fail ("Couldn't refresh"); plain --fail = startup.
#                                                 fail=refresh skips the 60 s rate limit unless --ratelimit is given
#     --mockdelay[=| ]<ms>                        how long the mock load takes (default 300), to test HOME / B during it
#     --ratelimit[=| ]<seconds>                   Refresh rate limit (default 60; 0 = off, so every Refresh fetches)
#     --api <base-url>                            catalog API base instead of http://hbb1.oscwii.org/api/v4 (a dead port
#                                                 gives the error screen, tools/http_test_server.py gives "bad data")
#     --autorefresh[=| ]<ms>                      press Refresh by itself after Home has been up that long (no clicking needed; 0 = every time Home appears)
#     --topbar all                                preview every top-bar action button (fake progress and badge)
#     --perf                                      log draw / present / frame times and the texture count every 120 frames
#     --nettest <script>                          dev-only network self-test: GET URLs through the worker and log the results
#     --nettestbg <url>                           ... plus a Background download alongside (shorthand for bg:<url> first)
#     --nettestquit                               quit by itself when the script ends (a bg job still running tests stop())
#                                                 Script syntax: src/net/NetSelfTest.h. The UI is untouched. Off by default.
#   On Wii they are written to <app dir>/devstart as key=value lines (env vars don't reach
#   Dolphin); on PC they are exported as OPENSHOP_START / _MOCK / _OFFLINE / _REFRESH / _FAIL / _TOPBAR / _MOCKDELAY / _RATELIMIT / _API / _AUTOREFRESH / _PERF / _NETTEST / _NETTESTBG / _NETTESTQUIT.
#   Dolphin's virtual SD card is synced with ./sdcard (put bgm.mp3 in sdcard/apps/OpenShop/).
#   ./sdcard is a symlink to .dolphin/sdcard; .dolphin/ is the only repo dir Dolphin may write to.
#   ./dev package             build dist/OpenShop.zip for the Homebrew Channel (SD:/apps/OpenShop)
#   ./dev wiiload             send the .dol to a real Wii running HBC (set WIILOAD=tcp:<wii-ip>)
#   ./dev headers             copy SDK headers to .devkitpro/ for editor IntelliSense
#   ./dev shell               open a shell inside the toolchain container
#
# Toolchain: uses a native devkitPro install if $DEVKITPPC is set, otherwise the
# official devkitpro/devkitppc container via podman (or docker).
# Environment overrides: DKP_IMAGE, DOLPHIN, DOLPHIN_ARGS, WATCH_INTERVAL,
# DOLPHIN_STOP_TIMEOUT (seconds to wait for Dolphin to stop cleanly, default 10).

set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
cd "$ROOT"

TARGET=OpenShop
DKP_IMAGE="${DKP_IMAGE:-docker.io/devkitpro/devkitppc:latest}"
DOLPHIN_APP=org.DolphinEmu.dolphin-emu
WATCH_INTERVAL="${WATCH_INTERVAL:-1}"
DOLPHIN_STOP_TIMEOUT="${DOLPHIN_STOP_TIMEOUT:-10}"
WATCH_PATHS=(src assets Makefile Makefile.pc)
# ./sdcard is what the user and the PC build use. Dolphin's sync folder is the real directory
# .dolphin/sdcard (./sdcard is a symlink to it), so the Flatpak only needs write access to .dolphin/.
SD_DIR="$ROOT/sdcard"
DOLPHIN_DIR="$ROOT/.dolphin"
DOLPHIN_SYNC_DIR="$DOLPHIN_DIR/sdcard"
APP_DIR="$SD_DIR/apps/$TARGET"
SCREENS=(home search list detail dialog)

c_info=$'\e[1;36m'; c_ok=$'\e[1;32m'; c_err=$'\e[1;31m'; c_off=$'\e[0m'
info() { echo "${c_info}==>${c_off} $*"; }
ok()   { echo "${c_ok}==>${c_off} $*"; }
err()  { echo "${c_err}==>${c_off} $*" >&2; }

# ---------------------------------------------------------------- toolchain

container_cmd() {
	if command -v podman >/dev/null; then echo podman
	elif command -v docker >/dev/null; then echo docker
	else err "No devkitPPC found: install devkitPro (wii-dev) or podman/docker."; exit 1
	fi
}

# Run a command with the devkitPPC environment available.
dkp() {
	if [[ -n "${DEVKITPPC:-}" ]]; then
		"$@"
	else
		local engine; engine="$(container_cmd)"
		local tty=(); [[ -t 0 && -t 1 ]] && tty=(-it)
		local userns=(); [[ "$engine" == podman ]] && userns=(--userns=keep-id)
		# Mount the project at the same path so debug info / error paths match the host.
		"$engine" run --rm "${tty[@]}" "${userns[@]}" \
			-v "$ROOT:$ROOT" -w "$ROOT" \
			-e WIILOAD="${WIILOAD:-}" \
			"$DKP_IMAGE" "$@"
	fi
}

build() {
	info "Building $TARGET"
	if dkp make -j"$(nproc)" "$@"; then
		ok "Built $TARGET.dol"
	else
		err "Build failed"; return 1
	fi
}

# ---------------------------------------------------------------- dolphin

# Fills the global DOLPHIN_CMD array. $DOLPHIN may hold a command plus arguments; it is split on
# whitespace only (no globbing).
dolphin_cmd() {
	if [[ -n "${DOLPHIN:-}" ]]; then
		read -r -a DOLPHIN_CMD <<< "$DOLPHIN"
	elif flatpak info "$DOLPHIN_APP" >/dev/null 2>&1; then
		# The sandbox sees the host read-only. Only .dolphin/ is writable: on clean shutdown Dolphin
		# syncs the virtual SD back by renaming the sync folder to a backup and unpacking a fresh
		# one, and a rename needs a writable parent directory (.dolphin/, parent of .dolphin/sdcard).
		DOLPHIN_CMD=(flatpak run "--filesystem=$DOLPHIN_DIR" "$DOLPHIN_APP")
	elif command -v dolphin-emu >/dev/null; then
		DOLPHIN_CMD=(dolphin-emu)
	else
		err "Dolphin not found. Install it with: flatpak install --user flathub $DOLPHIN_APP"; exit 1
	fi
}

# True while the process exists and is not a zombie (a finished child we haven't reaped yet).
pid_alive() {
	local st; st="$(ps -o stat= -p "$1" 2>/dev/null)" || return 1
	[[ -n "$st" && "$st" != Z* ]]
}

# Pids of the real dolphin-emu process(es) running this project's .elf. Under Flatpak the pid
# from `flatpak run &` is only a launcher (it even exits on Ctrl+C while the sandbox lives on),
# and the emulator is visible from the host pid namespace. We compare argv elements exactly
# ("-e" followed by our .elf path, no regex), which keeps any other Dolphin the user has open
# out of this.
dolphin_pids() {
	local p i
	local -a argv
	for p in $(pgrep -x dolphin-emu 2>/dev/null || true); do
		mapfile -d '' -t argv < "/proc/$p/cmdline" 2>/dev/null || continue
		for (( i = 0; i + 1 < ${#argv[@]}; i++ )); do
			if [[ "${argv[i]}" == -e && "${argv[i+1]}" == "$ROOT/$TARGET.elf" ]]; then echo "$p"; break; fi
		done
	done
	return 0
}

# Block until Dolphin has exited (launcher first, then the emulator itself).
wait_dolphin_exit() {
	[[ -f build/.dolphin.pid ]] && { wait "$(cat build/.dolphin.pid)" 2>/dev/null || true; }
	while [[ -n "$(dolphin_pids)" ]]; do sleep 0.2; done
	rm -f build/.dolphin.pid
}

# Stop Dolphin cleanly. Dolphin only syncs the virtual SD back to ./sdcard when emulation
# shuts down normally. DolphinQt treats SIGINT as "stop emulation and exit" (it prints "A
# signal was received. A second signal will force Dolphin to stop."), so we send one SIGINT
# and wait for the process to exit. Force-killing is the last resort and loses SD writes.
#   stop_dolphin       send SIGINT, then wait
#   stop_dolphin tty   the terminal's Ctrl+C already reached Dolphin (same process group);
#                      only wait. A second SIGINT would make Dolphin force-stop, skipping the sync.
stop_dolphin() {
	local already_signalled="${1:-}"
	local pids; pids="$(dolphin_pids)"
	if [[ -n "$pids" ]]; then
		[[ "$already_signalled" == tty ]] || kill -INT $pids >/dev/null 2>&1 || true
		info "Waiting for Dolphin to stop (it syncs the virtual SD card to ./sdcard)"
		local waited=0 limit=$(( DOLPHIN_STOP_TIMEOUT * 5 ))
		while [[ -n "$(dolphin_pids)" ]] && (( waited < limit )); do sleep 0.2; waited=$(( waited + 1 )); done
		pids="$(dolphin_pids)"
		if [[ -n "$pids" ]]; then
			err "Dolphin did not stop within ${DOLPHIN_STOP_TIMEOUT}s: force-killing it."
			err "WARNING: the virtual SD card was probably NOT synced, so files the app wrote this session are lost."
			# Only this project's pids: `flatpak kill` would take down every Dolphin the user has open.
			kill -KILL $pids >/dev/null 2>&1 || true
		fi
	fi
	if [[ -f build/.dolphin.pid ]]; then
		wait "$(cat build/.dolphin.pid)" 2>/dev/null || true
		rm -f build/.dolphin.pid
	fi
}

# Launch Dolphin on the .elf (keeps symbols for Dolphin's debugger).
# -b exits Dolphin when emulation stops, so closing the game closes the window.
# The -C overrides route the OSREPORT log channel (SYS_Report / LOG()) to stdout and
# point the virtual SD card at ./sdcard, without touching your saved Dolphin settings.
launch_dolphin() {
	stop_dolphin
	prepare_sd
	dolphin_cmd
	local cmd=("${DOLPHIN_CMD[@]}")
	local extra=()
	[[ -z "${DOLPHIN_ARGS:-}" ]] || read -r -a extra <<< "$DOLPHIN_ARGS"
	info "Launching Dolphin (logs below, Ctrl+C or close window to stop)"
	"${cmd[@]}" -b \
		-C Logger.Options.WriteToConsole=True \
		-C Logger.Options.Verbosity=2 \
		-C Logger.Logs.OSREPORT=True \
		-C Logger.Logs.OSREPORT_HLE=True \
		-C Dolphin.Interface.ConfirmStop=False \
		-C Dolphin.Core.WiiSDCard=True \
		-C Dolphin.Core.WiiSDCardEnableFolderSync=True \
		-C "Dolphin.General.WiiSDCardSyncFolder=$DOLPHIN_SYNC_DIR" \
		-C "Dolphin.General.WiiSDCardPath=$DOLPHIN_DIR/dolphin-sd.raw" \
		${extra[@]+"${extra[@]}"} \
		-e "$ROOT/$TARGET.elf" "$@" &
	echo $! > build/.dolphin.pid
}

# Copy hbc/meta.xml to $1, with <version> taken from OPENSHOP_VERSION in src/core/Version.h
# so the two can't drift apart.
install_meta() {
	local ver; ver="$(sed -n 's/^#define OPENSHOP_VERSION "\(.*\)"/\1/p' src/core/Version.h)"
	[[ -n "$ver" ]] || { err "OPENSHOP_VERSION not found in src/core/Version.h"; return 1; }
	sed "s|<version>[^<]*</version>|<version>$ver</version>|" hbc/meta.xml > "$1"
}

# Dev options (see top of file) as key=value lines for the Wii build's devstart file.
devstart_text() {
	[[ -n "$START_SCREEN" ]] && echo "screen=$START_SCREEN"
	(( OPT_MOCK )) && echo "mock=1"
	(( OPT_OFFLINE )) && echo "offline=1"
	(( OPT_REFRESH )) && echo "refresh=1"
	[[ -n "$OPT_FAIL" ]] && echo "fail=$OPT_FAIL"
	[[ -n "$OPT_MOCKDELAY" ]] && echo "mockdelay=$OPT_MOCKDELAY"
	[[ -n "$OPT_RATELIMIT" ]] && echo "ratelimit=$OPT_RATELIMIT"
	[[ -n "$OPT_API" ]] && echo "api=$OPT_API"
	[[ -n "$OPT_AUTOREFRESH" ]] && echo "autorefresh=$OPT_AUTOREFRESH"
	[[ -n "$OPT_TOPBAR" ]] && echo "topbar=$OPT_TOPBAR"
	(( OPT_PERF )) && echo "perf=1"
	[[ -n "$OPT_NETTEST" ]] && echo "nettest=$OPT_NETTEST"
	[[ -n "$OPT_NETTESTBG" ]] && echo "nettestbg=$OPT_NETTESTBG"
	(( OPT_NETTESTQUIT )) && echo "nettestquit=1"
	return 0
}

# Make ./sdcard a symlink to the real folder .dolphin/sdcard. An existing real ./sdcard directory
# (from before this layout) is moved over, not copied, so nothing is lost.
setup_sd_dirs() {
	mkdir -p "$DOLPHIN_DIR" build
	if [[ -L "$SD_DIR" ]]; then
		[[ "$(readlink "$SD_DIR")" == ".dolphin/sdcard" ]] || { rm "$SD_DIR"; ln -s .dolphin/sdcard "$SD_DIR"; }
	elif [[ -e "$SD_DIR" ]]; then
		if [[ -e "$DOLPHIN_SYNC_DIR" ]]; then
			err "Both ./sdcard and .dolphin/sdcard exist; merge them by hand (keep .dolphin/sdcard), then delete ./sdcard."
			return 1
		fi
		info "Moving ./sdcard to .dolphin/sdcard (./sdcard becomes a symlink to it)"
		mv "$SD_DIR" "$DOLPHIN_SYNC_DIR"
		ln -s .dolphin/sdcard "$SD_DIR"
	else
		mkdir -p "$DOLPHIN_SYNC_DIR"
		ln -s .dolphin/sdcard "$SD_DIR"
	fi
	mkdir -p "$DOLPHIN_SYNC_DIR"
}

prepare_sd() {
	setup_sd_dirs
	mkdir -p "$APP_DIR"
	install_meta "$APP_DIR/meta.xml"
	local text; text="$(devstart_text)"
	if [[ -n "$text" ]]; then echo "$text" > "$APP_DIR/devstart"
	else rm -f "$APP_DIR/devstart"; fi
}

# ---------------------------------------------------------------- pc build

pc_build() {
	if ! pkg-config --exists sdl2 SDL2_ttf SDL2_mixer SDL2_image jansson 2>/dev/null; then
		err "SDL2 development packages missing. Install them with:"
		echo "    sudo apt install libsdl2-dev libsdl2-ttf-dev libsdl2-mixer-dev libjansson-dev libsdl2-image-dev" >&2
		return 1
	fi
	info "Building $TARGET (Linux)"
	if make -f Makefile.pc -j"$(nproc)" "$@"; then ok "Built build-pc/openshop"
	else err "Build failed"; return 1; fi
}

stop_pc() {
	if [[ -f build-pc/.pid ]]; then
		local pid; pid="$(cat build-pc/.pid)"
		rm -f build-pc/.pid
		# The pid file can be stale (the pid may have been reused), so only kill an actual openshop.
		if [[ "$pid" =~ ^[0-9]+$ && "$(cat "/proc/$pid/comm" 2>/dev/null)" == openshop ]]; then
			kill "$pid" >/dev/null 2>&1 || true
			local i; for i in $(seq 1 25); do pid_alive "$pid" || break; sleep 0.2; done
			wait "$pid" 2>/dev/null || true
		fi
	fi
}

launch_pc() {
	stop_pc
	prepare_sd
	info "Launching Linux build (Ctrl+C or close window to stop)"
	OPENSHOP_DATA="$APP_DIR" OPENSHOP_START="$START_SCREEN" OPENSHOP_MOCK="$OPT_MOCK" \
		OPENSHOP_OFFLINE="$OPT_OFFLINE" OPENSHOP_REFRESH="$OPT_REFRESH" OPENSHOP_FAIL="$OPT_FAIL" OPENSHOP_TOPBAR="$OPT_TOPBAR" \
		OPENSHOP_MOCKDELAY="$OPT_MOCKDELAY" OPENSHOP_RATELIMIT="$OPT_RATELIMIT" OPENSHOP_API="$OPT_API" OPENSHOP_AUTOREFRESH="$OPT_AUTOREFRESH" OPENSHOP_PERF="$OPT_PERF" \
		OPENSHOP_NETTEST="$OPT_NETTEST" OPENSHOP_NETTESTBG="$OPT_NETTESTBG" OPENSHOP_NETTESTQUIT="$OPT_NETTESTQUIT" ./build-pc/openshop &
	echo $! > build-pc/.pid
}

# ---------------------------------------------------------------- watch

snapshot() {
	find "${WATCH_PATHS[@]}" -type f -printf '%p %T@\n' 2>/dev/null | sort | md5sum
}

# watch <build-fn> <launch-fn> <stop-fn>
watch() {
	local build_fn=$1 launch_fn=$2 stop_fn=$3
	# Ctrl+C also reaches Dolphin directly (same process group), so only wait for it on INT.
	trap "$stop_fn ${STOP_ON_INT:-}; exit 0" INT
	trap "$stop_fn; exit 0" TERM
	$build_fn && $launch_fn || true
	local last; last="$(snapshot)"
	info "Watching ${WATCH_PATHS[*]} for changes"
	while sleep "$WATCH_INTERVAL"; do
		local now; now="$(snapshot)"
		[[ "$now" == "$last" ]] && continue
		last="$now"
		echo
		info "Change detected"
		$build_fn && $launch_fn || err "Build failed, keeping the previous session"
	done
}

# ---------------------------------------------------------------- misc

package() {
	build
	local stage="build/package/apps/$TARGET"
	rm -rf build/package && mkdir -p "$stage" dist
	cp "$TARGET.dol" "$stage/boot.dol"
	install_meta "$stage/meta.xml"
	[[ -f hbc/icon.png ]] && cp hbc/icon.png "$stage/"
	rm -f "dist/$TARGET.zip"
	(cd build/package && python3 -m zipfile -c "$ROOT/dist/$TARGET.zip" apps)
	ok "dist/$TARGET.zip (extract to SD card root)"
}

headers() {
	local out="$ROOT/.devkitpro"
	info "Copying SDK headers to .devkitpro/"
	rm -rf "$out" && mkdir -p "$out"
	dkp bash -c "cd \$DEVKITPRO && tar ch libogc/include devkitPPC/powerpc-eabi/include \
		devkitPPC/lib/gcc/powerpc-eabi/*/include portlibs/ppc/include portlibs/wii/include" \
		| tar x -C "$out"
	ln -sfn "$(cd "$out/devkitPPC/lib/gcc/powerpc-eabi" && ls | head -1)/include" \
		"$out/devkitPPC/lib/gcc/powerpc-eabi/current"
	ok "Headers ready ($(du -sh "$out" | cut -f1))"
}

usage() { awk 'NR > 1 && /^#/ { sub(/^# ?/, ""); print; next } NR > 1 { exit }' "$0"; }

cmd="${1:-}"; shift || true
START_SCREEN=""; OPT_MOCK=0; OPT_OFFLINE=0; OPT_REFRESH=0; OPT_FAIL=""; OPT_TOPBAR=""; OPT_MOCKDELAY=""; OPT_RATELIMIT=""; OPT_API=""; OPT_AUTOREFRESH=""; OPT_PERF=0; OPT_NETTEST=""; OPT_NETTESTBG=""; OPT_NETTESTQUIT=0
while [[ $# -gt 0 ]]; do
	case "$1" in
		--screen)
			START_SCREEN="${2:-}"
			case " ${SCREENS[*]} " in
				*" $START_SCREEN "*) [[ -n "$START_SCREEN" ]] || { err "--screen needs a name (${SCREENS[*]})"; exit 1; } ;;
				*) err "--screen: '${2:-}' is not one of: ${SCREENS[*]}"; exit 1 ;;
			esac
			shift 2 ;;
		--mock)    OPT_MOCK=1; shift ;;
		--offline) OPT_OFFLINE=1; shift ;;
		--refresh) OPT_REFRESH=1; shift ;;
		--perf)    OPT_PERF=1; shift ;;
		--nettestquit) OPT_NETTESTQUIT=1; shift ;;
		--nettest|--nettestbg)
			[[ -n "${2:-}" && "${2:0:2}" != -- ]] || { err "$1: needs a value"; exit 1; }
			[[ "$2" != *[[:space:]]* ]] || { err "$1: no spaces (separate script items with commas)"; exit 1; }
			if [[ "$1" == --nettest ]]; then OPT_NETTEST="$2"; else OPT_NETTESTBG="$2"; fi
			shift 2 ;;
		--fail)
			# Plain --fail means startup; "--fail refresh" (space form) takes the next word only if it is a value.
			case "${2:-}" in startup|refresh|both|none|0|1) OPT_FAIL="$2"; shift 2 ;; *) OPT_FAIL=startup; shift ;; esac ;;
		--fail=*)
			OPT_FAIL="${1#--fail=}"
			case "$OPT_FAIL" in startup|refresh|both|none|0|1) ;; *) err "--fail: use startup, refresh, both or none"; exit 1 ;; esac
			shift ;;
		--mockdelay|--ratelimit|--autorefresh|--mockdelay=*|--ratelimit=*|--autorefresh=*)
			if [[ "$1" == *=* ]]; then name="${1%%=*}"; val="${1#*=}"; shift; else name="$1"; val="${2:-}"; shift $(( $# > 1 ? 2 : 1 )); fi
			[[ "$val" =~ ^[0-9]{1,7}$ ]] || { err "$name: needs a number"; exit 1; }
			case "$name" in --mockdelay) OPT_MOCKDELAY="$val" ;; --autorefresh) OPT_AUTOREFRESH="$val" ;; *) OPT_RATELIMIT="$val" ;; esac ;;
		--api|--api=*)
			if [[ "$1" == --api=* ]]; then OPT_API="${1#--api=}"; shift; else OPT_API="${2:-}"; shift $(( $# > 1 ? 2 : 1 )); fi
			[[ "$OPT_API" == http://* || "$OPT_API" == https://* ]] || { err "--api: needs a URL like http://host:port/api/v4"; exit 1; } ;;
		--topbar|--topbar=*)
			if [[ "$1" == --topbar=* ]]; then OPT_TOPBAR="${1#--topbar=}"; shift; else OPT_TOPBAR="${2:-}"; shift $(( $# > 1 ? 2 : 1 )); fi
			[[ "$OPT_TOPBAR" == all ]] || { err "--topbar: only 'all' is supported"; exit 1; } ;;
		*) break ;;
	esac
done
case "$cmd" in
	build)    build "$@" ;;
	run)      build && { trap 'stop_dolphin tty; exit 0' INT; trap 'stop_dolphin; exit 0' TERM
	                     launch_dolphin "$@"; wait_dolphin_exit; } ;;
	watch)    STOP_ON_INT=tty watch build launch_dolphin stop_dolphin ;;
	pc)       pc_build && { trap 'stop_pc; exit 0' INT TERM; launch_pc; wait "$(cat build-pc/.pid)" || true; rm -f build-pc/.pid; } ;;
	watch-pc) watch pc_build launch_pc stop_pc ;;
	clean)    dkp make clean; make -f Makefile.pc clean >/dev/null; make -f Makefile.pc SAN=1 clean >/dev/null; rm -rf dist ;;
	package) package ;;
	wiiload)
		[[ -n "${WIILOAD:-}" ]] || { err "Set WIILOAD=tcp:<wii-ip> first"; exit 1; }
		build && dkp bash -c "\$DEVKITPRO/tools/bin/wiiload $TARGET.dol" ;;
	headers) headers ;;
	shell)   dkp bash ;;
	*)       usage ;;
esac
